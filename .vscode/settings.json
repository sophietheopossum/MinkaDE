{
  // This workspace roots all of MinkaDE, including ~300G of build output
  // (ShojiWM/target, Floorp-Runtime objdir, MinkaPKG src/pkg). Keep the
  // watcher and search indexer out of it: nothing under these paths is
  // ever edited by hand, and watching them is what balloons the
  // extension host into swap.
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.hg/store/**": true,
    "**/target/**": true,
    "**/obj-*/**": true,
    "**/MinkaPKG/*/src/**": true,
    "**/MinkaPKG/*/pkg/**": true
  },
  // rust-analyzer stops at the first Cargo.toml it finds, so the MinkaDE
  // Cargo workspace (Cargo.toml here) would hide the projects with
  // workspaces of their own. List them beside it so they stay loaded.
  // Through lspmux this only takes effect when VS Code is the instance's
  // first client: if a Claude Code session started it, kill that
  // rust-analyzer by its PID (lspmux status) and restart the server here.
  "rust-analyzer.linkedProjects": [
    "Cargo.toml",
    "AntiWebUI/Cargo.toml",
    "ShojiWM/Cargo.toml",
    "xwayland-satellite/Cargo.toml",
    "smithay/Cargo.toml",
    "GitComet/Cargo.toml"
  ],
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/target": true,
    "**/obj-*": true,
    "**/MinkaPKG/*/src": true,
    "**/MinkaPKG/*/pkg": true
  }
}
